{
  "expo": {
    "name": "PhotoVault",
    "slug": "photo-vault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "photovault",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.photovault.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "PhotoVault requires access to your photo library to display, manage, and back up your photos and videos.",
        "NSPhotoLibraryAddUsageDescription": "PhotoVault needs permission to save downloaded photos to your library.",
        "NSFaceIDUsageDescription": "PhotoVault uses Face ID to securely lock and unlock your private photos and albums."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C1C1E",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.photovault.app",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "Grant PhotoVault access to display and sync your photos.",
          "savePhotosPermission": "Grant PhotoVault permission to save downloaded photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow PhotoVault to use Face ID to protect your private albums."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "43a45643-c882-4df9-acb2-7f6696bd40ad"
      }
    }
  }
}
